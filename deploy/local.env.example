# Where Captylo is deployed. Copy to deploy/local.env (git-ignored) and fill in; the server's
# name and folders stay out of the public repo. Read by server/deploy/deploy.sh and
# scripts/publish-release.sh; an environment variable of the same name wins over the file.
# Plain KEY=value lines, no quotes, no spaces around "=".

# ssh host (an alias from ~/.ssh/config) that runs Docker and the shared Caddy
DEPLOY_HOST=
# folder of the captylo-api compose stack on that host (docker-compose.yml, .env, src/)
DEPLOY_STACK=

# ssh host that serves captylo.com
PUBLISH_HOST=
# captylo.com web root on that host (site/ is synced here with --delete)
PUBLISH_SITE_ROOT=
# folder with the DMGs, outside the web root (served by deploy/Caddyfile.captylo.snippet)
PUBLISH_DOWNLOADS=
