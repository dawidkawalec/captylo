    "W chwili startu": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "At the start" } }
      }
    },
    "%lld min": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "%lld min" } }
      }
    },
    "Nadchodzące": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Upcoming" } }
      }
    },
    "Trwa": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Now" } }
      }
    },
    "Za %lld min: „%@” (%@). Nagrać notatki?": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "In %1$lld min: “%2$@” (%3$@). Record notes?" } }
      }
    },
    "Zaczyna się: „%@” (%@). Nagrać notatki?": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Starting now: “%1$@” (%2$@). Record notes?" } }
      }
    },
    "Wykrywanie mowy do spotkań: gotowe": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Meeting speech detection: ready" } }
      }
    },
    "Redukcja echa (eksperymentalna)": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Echo reduction (experimental)" } }
      }
    },
    "Próbuje usunąć z Twojego mikrofonu to, co słychać z głośników. Zmiana działa od następnego spotkania; z niektórymi słuchawkami Bluetooth się nie włącza.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Tries to remove what the speakers play from your microphone. The change applies from the next meeting; it does not turn on with some Bluetooth headphones." } }
      }
    },
    "Wykrywanie mowy do spotkań: pobieram...": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Meeting speech detection: downloading..." } }
      }
    },
    "Wykrywanie mowy do spotkań: nie pobrano (%@)": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Meeting speech detection: not downloaded (%@)" } }
      }
    },
    "Zapytaj": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ask" } }
      }
    },
    "Zapytaj o to spotkanie...": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ask about this meeting..." } }
      }
    },
    "Zapytaj o cokolwiek z tego spotkania. Odpowiedź wskaże momenty rozmowy, z których pochodzi.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ask anything about this meeting. The answer points to the moments of the conversation it comes from." } }
      }
    },
    "Co ustaliliśmy?": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "What did we agree on?" } }
      }
    },
    "Jakie są zadania i kto je robi?": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "What are the tasks and who does them?" } }
      }
    },
    "O co pytał klient?": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "What did the client ask about?" } }
      }
    },
    "Szukam odpowiedzi...": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Looking for the answer..." } }
      }
    },
    "Wyczyścić pytania?": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Clear the questions?" } }
      }
    },
    "Pytania i odpowiedzi o to spotkanie znikną.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The questions and answers about this meeting will be removed." } }
      }
    },
    "Usuń pytania i odpowiedzi o to spotkanie": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Remove the questions and answers about this meeting" } }
      }
    },
    "Nie udało się wyczyścić pytań.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Could not clear the questions." } }
      }
    },
    "Zapytaj działa po zakończeniu spotkania.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ask works once the meeting has ended." } }
      }
    },
    "W tym spotkaniu jest za mało rozmowy, żeby odpowiedzieć.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "There is too little conversation in this meeting to answer." } }
      }
    },
    "Zapytaj jest w Captylo Pro": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ask is part of Captylo Pro" } }
      }
    },
    "Zadaj pytanie o spotkanie i dostań krótką odpowiedź z odnośnikami do momentów rozmowy.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ask a question about a meeting and get a short answer that links to the moments of the conversation." } }
      }
    },
    "Pytania": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Questions" } }
      }
    },
    "Zapytaj wszystkie": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ask all" } }
      }
    },
    "Zadaj pytanie o wszystkie spotkania": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ask a question about all meetings" } }
      }
    },
    "Zapytaj wszystkie spotkania": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ask all meetings" } }
      }
    },
    "Zapytaj wszystkie spotkania jest w Captylo Pro": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ask all meetings is part of Captylo Pro" } }
      }
    },
    "Zadaj jedno pytanie o wszystkie spotkania i dostań krótką odpowiedź ze źródłami i odnośnikami do momentów rozmowy.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ask one question about all your meetings and get a short answer with its sources and links to the moments of the conversation." } }
      }
    },
    "Odpowiedź z Twoich spotkań, ze źródłami i odnośnikami do momentów rozmowy. Pytania znikają po zamknięciu Captylo.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "An answer from your meetings, with its sources and links to the moments of the conversation. Questions disappear when you quit Captylo." } }
      }
    },
    "Zapytaj o cokolwiek z rozmów na tym Macu. Captylo znajdzie pasujące spotkania i pokaże, skąd pochodzi odpowiedź.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ask about anything from the conversations on this Mac. Captylo finds the meetings that match and shows where the answer comes from." } }
      }
    },
    "Zapytaj o wszystkie spotkania...": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ask about all meetings..." } }
      }
    },
    "Co ustaliliśmy w tym tygodniu?": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "What did we agree on this week?" } }
      }
    },
    "Jakie zadania są na mnie?": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Which tasks are mine?" } }
      }
    },
    "Co klienci mówili o cenie?": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "What did clients say about the price?" } }
      }
    },
    "Szukam w spotkaniach...": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Searching your meetings..." } }
      }
    },
    "Szukam tylko w notatkach AI, indeks się buduje.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Searching the AI notes only, the index is being built." } }
      }
    },
    "Nie znalazłem tego w spotkaniach.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "I couldn't find that in your meetings." } }
      }
    },
    "Źródła": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Sources" } }
      }
    },
    "Otwórz spotkanie": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Open the meeting" } }
      }
    },
    "Otwórz „%@” w tym miejscu": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Open “%@” at this moment" } }
      }
    },
    "Otwórz „%@”, %@": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Open “%1$@”, %2$@" } }
      }
    },
    "Dostęp dla asystentów AI (MCP)": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Access for AI assistants (MCP)" } }
      }
    },
    "Twój asystent AI (np. Claude Desktop, Cursor) może czytać i przeszukiwać spotkania na tym Macu. Tylko odczyt, nic nie wysyłamy.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Your AI assistant (e.g. Claude Desktop, Cursor) can read and search the meetings on this Mac. Read-only, we send nothing anywhere." } }
      }
    },
    "Skopiuj konfigurację": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Copy configuration" } }
      }
    },
    "Wklej ją w ustawieniach MCP asystenta (w Claude Desktop: Ustawienia > Developer > Edit Config) i uruchom go ponownie.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Paste it into the assistant's MCP settings (in Claude Desktop: Settings > Developer > Edit Config) and restart it." } }
      }
    },
    "Włącz dostęp w Captylo: Ustawienia > Spotkania > Dostęp dla asystentów AI (MCP).": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Turn on access in Captylo: Settings > Meetings > Access for AI assistants (MCP)." } }
      }
    },
    "Nie mogę odczytać spotkań Captylo. Uruchom Captylo na tym Macu (po aktualizacji raz wystarczy) i spróbuj ponownie.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Can't read the Captylo meetings. Open Captylo on this Mac (once is enough after an update) and try again." } }
      }
    },
    "Brak spotkań.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No meetings." } }
      }
    },
    "Nic nie znalazłem w spotkaniach.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Nothing found in the meetings." } }
      }
    },
    "Nie ma spotkania o tym id.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "There is no meeting with this id." } }
      }
    },
    "Nieprawidłowa data w „since”. Podaj datę jak 2026-10-01 albo datę z godziną w ISO 8601.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Invalid date in “since”. Give a date like 2026-10-01 or an ISO 8601 date and time." } }
      }
    },
    "Podaj id spotkania z list_meetings albo search_meetings.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Give a meeting id from list_meetings or search_meetings." } }
      }
    },
    "Podaj, czego szukać (query).": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Say what to look for (query)." } }
      }
    },
    "nagrywa się teraz": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "recording now" } }
      }
    }
