      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this mode"
          }
        }
      }
    },
    "Wbudowane tryby wrócą do oryginalnych nazw, promptów i limitów, a usunięte pojawią się ponownie. Twoje własne tryby zostaną bez zmian.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The built-in modes go back to their original names, prompts and limits, and deleted ones come back. Your own modes stay as they are."
