            "value": "Kind"
          }
        }
      }
    },
    "Sprawdź tryb na przykładowym dyktacie, także przed zapisaniem zmian. Test używa wybranego modelu i Twojego klucza API do AI.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try the mode on a sample dictation, even before saving your changes. The test uses the selected model and your AI API key."
          }
        }
      }
    },
    "Ten prompt nie używa Słownika, więc model nie zobaczy Twoich słów.": {
      "localizations": {
        "en": {
          "stringUnit": {
