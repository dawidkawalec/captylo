# macOS
.DS_Store

# Xcode (project is generated by XcodeGen, do not commit it)
*.xcodeproj
*.xcworkspace
xcuserdata/
DerivedData/
.build/
.local-build/
build/
*.xcresult
*.profraw

# Release output (scripts/release.sh): DMGs, signed apps, build logs, never committed
dist/

# Python bytecode (scripts/appcast.py tests)
__pycache__/

# SwiftPM
.swiftpm/
Package.resolved

# Secrets / local env (deploy/local.env names the server and its folders: never in the public repo)
deploy/local.env
.env
.env.*
!.env.example
*.key
*.p8
*.p12
*.mobileprovision

# Local agent worktrees and tool state
.claude/
.playwright-mcp/

# Temporary / scratch
_temp/
tmp/
scratch/
*.log
