# Captylo API configuration. Copy to .env and fill in; never commit .env.
# On the server the file lives in the stack folder (DEPLOY_STACK in deploy/local.env). Blank secrets are allowed only
# outside production (NODE_ENV=development or test); in production the server refuses to boot.

NODE_ENV=production
PORT=8080

# Postgres. On the VPS docker-compose.yml sets DATABASE_URL itself and hands this password
# to both containers (for example `openssl rand -hex 24`).
POSTGRES_PASSWORD=
# Subnet of the stack's own Docker network (docker-compose.yml); change it only if it is taken.
# CAPTYLO_API_SUBNET=10.250.46.0/24
# Local development only (docker-compose.yml overrides it on the VPS); the password can
# also come from PGPASSWORD instead of the URL:
# DATABASE_URL=postgres://captylo@127.0.0.1:5432/captylo

PUBLIC_SITE_URL=https://captylo.com

# Stripe (Dashboard > Developers): secret key, webhook signing secret, the two price ids.
# The webhook endpoint is https://api.captylo.com/v1/stripe/webhook on API version
# 2026-08-26.dahlia (see README.md, "Stripe", for the events to send).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_MONTHLY=

# Login code e-mails. Blank = codes are only recorded in memory (development).
RESEND_API_KEY=
MAIL_FROM=Captylo <konto@captylo.com>

# AI relay for Pro.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PRO_AI_MODEL=google/gemini-2.5-flash-lite

# Speech-to-text relay for Pro.
STT_API_KEY=
STT_BASE_URL=https://api.elevenlabs.io/v1

# Fair use per account per calendar month (UTC).
PRO_AUDIO_HOURS_PER_MONTH=20
PRO_AI_TOKENS_PER_MONTH=3000000

# Days a session may stay unused before it expires.
SESSION_DAYS=180
