  "description": "Captylo accounts, Pro subscriptions and the cloud relay (api.captylo.com)",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
